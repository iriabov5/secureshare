# Необязательные overrides для локальной разработки; defaults совпадают с application-local.yaml.
DB_NAME=secureshare
DB_USER=secureshare
DB_PASSWORD=secureshare-local-password
DB_PORT=55432
JDBC_URL=jdbc:postgresql://localhost:55432/secureshare
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=secureshare
S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=secureshare-local
AWS_SECRET_ACCESS_KEY=secureshare-local-secret
